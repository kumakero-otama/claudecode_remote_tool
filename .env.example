# ===== Claude Code Remote Tool 設定 =====
# このファイルを .env にコピーして値を埋めてください: cp .env.example .env
# トークン類は scripts/gen-secrets.sh で生成できます。

# --- 公開URL（Tailscale Funnel のMagicDNS名。スキーム必須・末尾スラッシュなし） ---
# 注意: 443(ルート)は別アプリ(StepBy)が使用中のため、本ツールは 8443 番で公開する。
#       そのため URL には :8443 を含める。
PUBLIC_URL=https://barrierfree-map.tail5de5e1.ts.net:8443

# --- コンポーネント間の共有トークン（openssl rand -hex 32 などで生成） ---
MCP_TOKEN=
GATEWAY_API_TOKEN=

# --- セッション(JWT)署名鍵。漏洩すると全セッション偽造可。十分に長くランダムに。 ---
SESSION_SECRET=
# 値を変えると既存ログインを全て無効化（緊急失効スイッチ）
SESSION_EPOCH=1

# パスキー必須の切替。true=Googleログイン後に端末パスキー登録/認証が必要（推奨）。
# false=Googleアカウントのみでログイン可（端末束縛なし・一時運用向け）。
REQUIRE_PASSKEY=true

# --- アクセス許可するGoogleアカウント（カンマ区切り、小文字） ---
ALLOWED_EMAILS=kumakero.otama@gmail.com

# --- Google OAuth クライアント（Google Cloud Console で発行） ---
# ★ Google Cloud Console の操作アカウントは yamashita.3154@gmail.com を使用すること。
#    （コンソール操作アカウントと、ログイン許可する ALLOWED_EMAILS は別物）
# 承認済みリダイレクトURI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 既存サーバ情報ダッシュボード(:8088)のURL（通常は変更不要） ---
SERVER_DASHBOARD_URL=http://host.docker.internal:8088

# --- 開発用（本番は触らない） ---
# NODE_ENV=development にし ALLOW_DEV_ENROLL=true にすると、
# Googleなしで /auth/dev?email=... により端末登録の動作確認が可能（localhost専用）。
NODE_ENV=production
ALLOW_DEV_ENROLL=false
